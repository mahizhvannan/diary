GEMINI_API_KEY=
CURSOR_API_KEY=
# Set to 1 on a private local machine to allow server env keys without BYOK headers.
# Never enable on a public/shared host.
DIARY_ALLOW_SERVER_KEYS=1
# Optional shared secret for Analyze API (alternative to Cursor BYOK).
# DIARY_ANALYZE_SECRET=
# Only this Google account can Connect (comma-separated for multiple).
NEXT_PUBLIC_ALLOWED_GOOGLE_EMAIL=you@gmail.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
